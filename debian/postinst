#!/bin/sh
set -e
# Reload user service manager registration is handled per-user by the WebUI;
# nothing to enable here — the player is toggled on via the HiFiBerry UI.
#DEBHELPER#

# sendspin runs as a systemd *user* service of the HiFiBerry user, and
# debhelper only restarts system services on upgrade. Without this, an
# upgraded player keeps running the old, already deleted binary until the
# next reboot or login. try-restart, so a player that is not running -- one
# switched off in the WebUI, or a fresh install -- is not started by this.
# Best effort; no-op during image builds, where no user manager runs.
user_systemctl() {
    [ -d /run/systemd/system ] || return 0
    [ -f /etc/hifiberry.user ] || return 0
    HB_USER=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$' /etc/hifiberry.user | head -1 | tr -d '[:space:]')
    [ -n "$HB_USER" ] && getent passwd "$HB_USER" >/dev/null 2>&1 || return 0
    HB_UID=$(id -u "$HB_USER" 2>/dev/null) || return 0
    [ -d "/run/user/$HB_UID" ] || return 0
    systemd-run --uid "$HB_UID" --setenv XDG_RUNTIME_DIR="/run/user/$HB_UID" \
        --pipe --wait --quiet --collect \
        systemctl --user "$@" >/dev/null 2>&1 || true
}

if [ "$1" = "configure" ]; then
    user_systemctl daemon-reload
    user_systemctl try-restart sendspin.service
fi

# NOTE: deliberately no `systemctl restart config-server` here.
#
# When the WebUI installs an extension, config-server is the process running
# apt, and it holds the install job the UI polls in memory. Restarting from a
# postinst -- which runs during dpkg's configure step, mid-install -- destroys
# that job. apt survives (the runner starts it under systemd-run) so the
# package installs correctly, but the UI is left polling an id that no longer
# exists and reports the install as lost.
#
# It is also unnecessary: configurator re-reads conf.d in place after every
# extension install, via refresh_system_state() in
# configurator/extensions/postinstall.py, whose docstring says exactly why --
# "Restarting is not an option here: it would kill the job the UI is polling."
#
# Caveat for a manual `apt install` from a shell: nothing calls
# refresh_system_state() on that path, so config-server keeps its cached
# conf.d until restarted by hand.

exit 0
